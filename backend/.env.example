PORT=3000
CORS_ORIGIN=http://localhost:4200

# Path to the checked-out Puppeteer repo (git submodule "scripts" by default).
SCRIPTS_DIR=../scripts

DB_PATH=./data/servisesvi.db

# Global cookies shared across scripts that log in to the same site, keyed by
# manifest input "cookieKey" (see manifests/SCHEMA.md).
COOKIE_VAULT_DIR=./data/cookies
